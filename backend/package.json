{
  "name": "supplier-directory-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.16.0" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "build": "node build.mjs",
    "start": "npm run db:migrate && node --env-file-if-exists=.env dist/index.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "typecheck": "tsc --noEmit",
    "test:directory-persistence": "esbuild src/lib/directory-persistence.integration.test.ts --bundle --platform=node --format=cjs --external:pg-native --outfile=dist/directory-persistence.test.cjs && NODE_ENV=test node dist/directory-persistence.test.cjs",
    "test:directory-onboarding": "npm run build && esbuild src/lib/directory-onboarding.integration.test.ts --bundle --platform=node --format=cjs --external:pg-native --outfile=dist/directory-onboarding.test.cjs && NODE_ENV=test node dist/directory-onboarding.test.cjs",
    "test:supplier-catalog": "esbuild src/routes/supplier-catalog.integration.test.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/catalog-integration.test.cjs && NODE_ENV=test DIRECTORY_STORAGE_MODE=sqlite-test node dist/catalog-integration.test.cjs",
    "test:supplier-invitation-replacement": "esbuild src/routes/supplier-invitation-replacement.integration.test.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/supplier-invitation-replacement.test.cjs && NODE_ENV=test DIRECTORY_STORAGE_MODE=sqlite-test node dist/supplier-invitation-replacement.test.cjs",
    "test:deployment": "esbuild src/lib/deployment.integration.test.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/deployment-test.cjs && node --test dist/deployment-test.cjs",
    "test": "npm run test:directory-persistence && npm run test:directory-onboarding && npm run test:supplier-catalog && npm run test:supplier-invitation-replacement && npm run test:deployment"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.1",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
